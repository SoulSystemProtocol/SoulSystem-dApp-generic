{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["envio-env.d.ts", "src/handlers/**/*.ts", "generated/**/*.ts"],
  "exclude": ["src/subgraph-reference"]
}
